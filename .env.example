# Port the server listens on
PORT=3000
# Where the SQLite database is stored
DB_FILE=data/roomradar.db
# Minutes without any activity before someone is automatically marked as "left"
PRESENCE_TIMEOUT_MIN=15
# Public URL used in QR codes and share links (set this when deploying, e.g. https://roomradar.onrender.com)
# PUBLIC_URL=
# Optional: enables AI-written conversation openers. Without it, openers are generated from shared interests.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
